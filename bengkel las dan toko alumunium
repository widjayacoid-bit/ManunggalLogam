    <!-- JavaScript Logic -->
    <script>
        // Mobile Menu Toggle
        const mobileMenuBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');

        mobileMenuBtn.addEventListener('click', () => {
            mobileMenu.classList.toggle('hidden');
        });

        // Close mobile menu when clicking links
        mobileMenu.querySelectorAll('a').forEach(link => {
            link.addEventListener('click', () => {
                mobileMenu.classList.add('hidden');
            });
        });

        // Interactive Cost Calculator
        const calcService = document.getElementById('calc-service');
        const calcVolume = document.getElementById('calc-volume');
        const calcResult = document.getElementById('calc-result');
        const calcWaBtn = document.getElementById('calc-wa-btn');

        function updateCalculator() {
            const selectedOption = calcService.options[calcService.selectedIndex];
            const basePrice = parseFloat(selectedOption.getAttribute('data-price'));
            const volume = parseFloat(calcVolume.value) || 0;
            const total = basePrice * volume;

            calcResult.textContent = new Intl.NumberFormat('id-ID', {
                style: 'currency',
                currency: 'IDR',
                maximumFractionDigits: 0
            }).format(total);

            // Update WhatsApp message
            const serviceName = selectedOption.text;
            const waMessage = `Halo%20CV.%20Manunggal%20Logam,%20saya%20ingin%20memesan%20${encodeURIComponent(serviceName)}%20dengan%20volume%20sekitar%20${volume}%20unit/m²%20(Estimasi%20total:%20${encodeURIComponent(calcResult.textContent)}).%20Mohon%20info%20lanjut.`;
            calcWaBtn.setAttribute('href', `https://wa.me/6287808813777?text=${waMessage}`);
        }

        calcService.addEventListener('change', updateCalculator);
        calcVolume.addEventListener('input', updateCalculator);
        updateCalculator(); // Initialize on load

        // Portfolio Filtering
        const filterBtns = document.querySelectorAll('.filter-btn');
        const portfolioItems = document.querySelectorAll('.portfolio-item');

        filterBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                // Remove active class from all
                filterBtns.forEach(b => {
                    b.classList.remove('bg-brand-600', 'text-white', 'shadow-sm');
                    b.classList.add('bg-stone-100', 'text-stone-700');
                });
                // Add active to clicked
                btn.classList.add('bg-brand-600', 'text-white', 'shadow-sm');
                btn.classList.remove('bg-stone-100', 'text-stone-700');

                const filter = btn.getAttribute('data-filter');

                portfolioItems.forEach(item => {
                    if (filter === 'all' || item.getAttribute('data-category') === filter) {
                        item.style.display = 'block';
                    } else {
                        item.style.display = 'none';
                    }
                });
            });
        });
    </script>
